{
  "name": "trymc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A browser-based voxel sandbox game built with Three.js: procedural terrain, first-person controls, block building, and chunk streaming.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.170.0",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
